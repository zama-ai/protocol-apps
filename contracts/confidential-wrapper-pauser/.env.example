# Authentication
MNEMONIC=
PRIVATE_KEY=

# RPC URLs
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
SEPOLIA_RPC_URL=
AMOY_RPC_URL=

# API Keys
ETHERSCAN_API_KEY=

# Gas Reporter
REPORT_GAS=false

# ----------------------------------------------------------------------------
# ConfidentialWrapperPauser deployment (deploy/ConfidentialWrapperPauser.ts)
# ----------------------------------------------------------------------------

# Owner (Ownable2Step): the chain's governance.
# Must match config/networks.json for the target network unless PAUSER_ALLOW_OWNER_MISMATCH=true.
PAUSER_OWNER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8  # accounts[1] (address)
# Day-one roster (JSON array of addresses). No zero address, no duplicates.
PAUSER_INITIAL_PAUSERS='["0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC","0x90F79bf6EB2c4f870365E785982E1f101E93b906"]'
PAUSER_ALLOW_OWNER_MISMATCH=false
