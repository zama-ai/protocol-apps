# Authentication
MNEMONIC=
PRIVATE_KEY=

# RPC URLs
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
SEPOLIA_RPC_URL=
AMOY_RPC_URL=

# API Keys
ETHERSCAN_API_KEY=

# Gas Reporter
REPORT_GAS=false

# ----------------------------------------------------------------------------
# ConfidentialWrapperPauser deployment (deploy/ConfidentialWrapperPauser.ts)
# ----------------------------------------------------------------------------

# Default admin (AccessControlDefaultAdminRules; also returned by owner()): the chain's governance.
# Must match config/networks.json for the target network unless PAUSER_ALLOW_ADMIN_MISMATCH=true.
PAUSER_ADMIN_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8  # accounts[1] (address)
# Delay, in seconds, before a scheduled default admin transfer can be accepted. 0 = plain two-step
# (like Ownable2Step on the wrappers); the admin can raise it later with changeDefaultAdminDelay.
PAUSER_DEFAULT_ADMIN_DELAY=0
# ConfidentialTokenWrappersRegistry the pauser gates on (immutable). Leave empty to use config/networks.json for
# the target network; set it only for forks and local runs.
PAUSER_REGISTRY_ADDRESS=
# Day-one roster (JSON array of addresses). No zero address, no duplicates.
PAUSER_INITIAL_PAUSERS='["0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC","0x90F79bf6EB2c4f870365E785982E1f101E93b906"]'
PAUSER_ALLOW_ADMIN_MISMATCH=false
